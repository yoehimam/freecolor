# --- MODE DEMO vs PRODUKSI ---
# DEMO_MODE=1 : Nonaktifkan kewajiban mendaftar/login & bebaskan batas kuota foto (cocok untuk tahap demo).
# DEMO_MODE=0 : Aktifkan sistem akun, login/register, dan kuota harian saat aplikasi siap rilis.
DEMO_MODE=1

# --- KONFIGURASI AI VISION (OPSIONAL) ---
# AI_ENABLED=0 : Nonaktifkan pemakaian token AI selama demo (100% gratis, memakai Sensor Optik Lokal).
# AI_ENABLED=1 : Aktifkan pembacaan foto dengan AI Vision saat siap digunakan.
AI_ENABLED=0

# Pilihan provider AI: "gemini" (direkomendasikan, cepat & akurat) atau "openai"
AI_PROVIDER=gemini

# 1. Google Gemini API (Direkomendasikan — dapatkan di https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 2. OpenAI / Relay Compatible (Alternatif jika AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=60000

# --- SERVER & KEAMANAN ---
PORT=8787
COOKIE_SECURE=0
TRUST_PROXY=0
ALLOWED_ORIGINS=

# --- SERVICE SPEKTRUM PYTHON (FastAPI) ---
SPECTRAL_URL=http://127.0.0.1:8799
SPECTRAL_TOKEN=
HF_TOKEN=
HF_MODEL_ID=
ONNX_MODEL_PATH=
